{
  "name": "ata",
  "version": "0.2.0-rc.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run src/cli/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "build": "bun run scripts/derle.ts",
    "test:binary": "bun run scripts/binary-smoke.ts",
    "check:release": "bun run check && bun run release:prepare && bun run scripts/binary-smoke.ts --release && bun run test:installer",
    "release:runtime": "bun run scripts/runtime-hazırla.ts",
    "release:prepare": "bun run scripts/yayın-hazırla.ts",
    "release:verify": "bun run scripts/yayın-hazırla.ts --verify",
    "test:installer": "bun run scripts/installer-smoke.ts"
  },
  "dependencies": {
    "chevrotain": "^13.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
